{
  "name": "file-routing",
  "version": "0.0.8",
  "private": true,
  "type": "module",
  "description": "Executable file-routing example for the Kozo framework",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
