  },
  "dependencies": {
    "@kozojs/auth": "workspace:*",
    "@kozojs/core": "workspace:*",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.6.0"
  }
}
