{
  "name": "@kozojs/testing",
  "version": "0.7.0",
  "description": "Route-derived contract tests, raw injection, and native transport clients for Kozo Framework",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "files": [
    "lib",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:types": "tsc --noEmit -p type-tests/tsconfig.json",
    "test:watch": "vitest"
  },
  "keywords": [
    "kozo",
    "testing",
    "contract-testing",
    "type-safe",
    "test",
    "inject",
    "supertest",
    "http",
    "typescript"
  ],
  "author": "Kozo Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zazzo9039/kozojs.git"
  },
  "homepage": "https://github.com/zazzo9039/kozojs#readme",
  "bugs": "https://github.com/zazzo9039/kozojs/issues",
  "engines": {
    "node": ">=20.19.0"
  },
  "peerDependencies": {
    "@kozojs/core": "^0.7.0"
  },
  "devDependencies": {
    "@kozojs/core": "workspace:*",
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
