{
  "name": "@kozojs/auth",
  "version": "0.7.1",
  "description": "Authentication for Kozo that stays on the native uWebSockets fast path — JWT guards, roles, no bridge tax.",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "license": "MIT",
  "author": "Kozo Team",
  "repository": {
    "type": "git",
    "url": "https://github.com/zazzo9039/kozojs.git"
  },
  "homepage": "https://github.com/zazzo9039/kozojs#readme",
  "bugs": "https://github.com/zazzo9039/kozojs/issues",
  "keywords": [
    "kozo",
    "auth",
    "jwt",
    "authentication",
    "middleware"
  ],
  "files": [
    "lib",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "jose": "^5.9.0"
  },
  "devDependencies": {
    "@kozojs/core": "workspace:*",
    "@types/node": "^22.0.0",
    "hono": "^4.6.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "peerDependencies": {
    "@kozojs/core": "^0.7.0",
    "hono": "^4.0.0"
  }
}
