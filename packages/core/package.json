{
  "name": "@kozojs/core",
  "version": "0.5.1",
  "description": "High-performance TypeScript framework with type-safe client generation",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "license": "MIT",
  "author": "Kozo Team",
  "repository": {
    "type": "git",
    "url": "https://github.com/zazzo9039/kozo.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/zazzo9039/kozo/tree/main/packages/core#readme",
  "bugs": "https://github.com/zazzo9039/kozo/issues",
  "keywords": [
    "kozo",
    "framework",
    "backend",
    "typescript",
    "hono",
    "edge",
    "cloudflare",
    "workers",
    "api",
    "rest",
    "fast",
    "zod",
    "type-safe",
    "client-sdk",
    "codegen",
    "validation"
  ],
  "files": [
    "lib",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.js"
    },
    "./middleware": {
      "types": "./lib/middleware/index.d.ts",
      "import": "./lib/middleware/index.js",
      "require": "./lib/middleware/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "hono": "^4.6.0",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "uWebSockets.js": "*",
    "vite": ">=5.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.5",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "2.1.9",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vite": "^7.3.1",
    "vitest": "^2.1.0"
  },
  "peerDependenciesMeta": {
    "uWebSockets.js": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  }
}
