{
  "name": "@kozojs/redis",
  "version": "0.5.23",
  "description": "Redis integration for Kozo framework — cache, pub/sub, and distributed rate-limit store",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "files": [
    "lib",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.config.ts"
  },
  "keywords": [
    "kozo",
    "redis",
    "cache",
    "pubsub",
    "rate-limit"
  ],
  "author": "Kozo Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zazzo9039/kozojs.git"
  },
  "homepage": "https://github.com/zazzo9039/kozojs#readme",
  "bugs": "https://github.com/zazzo9039/kozojs/issues",
  "dependencies": {},
  "peerDependencies": {
    "ioredis": ">=5.0.0",
    "@kozojs/core": "^0.5.23"
  },
  "peerDependenciesMeta": {
    "@kozojs/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "ioredis": "^5.6.1",
    "@kozojs/core": "workspace:*",
    "vitest": "^2.1.9",
    "typescript": "^5.9.3",
    "tsup": "^8.5.1"
  }
}
