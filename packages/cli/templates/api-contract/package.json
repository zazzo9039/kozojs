    "@kozojs/testing": "^0.7.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.0",
    "tsx": "^4.21.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^2.1.0"
  }
